{
  "watchFolder":         "D:\\Impresiones",
  "historyFolder":       "D:\\Impresiones\\Historico",
  "errorFolder":         "D:\\Impresiones\\Errores",
  "logFolder":           "D:\\Impresiones\\Logs",
  "logLevel":            "info",
  "logRetentionDays":    30,
  "historyRetentionDays": 30,
  "errorRetentionDays":  90,
  "alertRetentionDays":  7,

  "printMethod":         "DIRECT",

  "gdiTimeoutMs":        60000,
  "classicTimeoutMs":    60000,

  "printers": {
    "voucher": {
      "name":            "EPSON TM-U950",
      "fontName":        "Courier New",
      "fontSize":        9,
      "bold":            false,
      "maxCharsPerLine": 40,
      "copies":          1
    },
    "slip": {
      "name":            "EPSON TM-U950",
      "fontName":        "Courier New",
      "fontSize":        9,
      "bold":            false,
      "maxCharsPerLine": 40,
      "copies":          1
    }
  },

  "fileEncoding":        "latin1",
  "fileAction":          "MOVE",
  "pollingIntervalMs":   1000,
  "fileStabilizeMs":     500,
  "retryCount":          3,
  "retryIntervalMs":     5000
}
