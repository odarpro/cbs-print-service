{
  "watchFolder":         "D:\\Impresiones",
  "historyFolder":       "D:\\Impresiones\\Historico",
  "errorFolder":         "D:\\Impresiones\\Errores",
  "logFolder":           "D:\\Impresiones\\Logs",
  "logLevel":            "info",
  "logRetentionDays":    30,

  "printMethod":         "DIRECT",

  "printers": {
    "voucher": {
      "name":            "Recibo",
      "fontName":        "Courier New",
      "fontSize":        9,
      "bold":            false,
      "maxCharsPerLine": 40,
      "copies":          1
    },
    "slip": {
      "name":            "Cheques",
      "fontName":        "Courier New",
      "fontSize":        9,
      "bold":            false,
      "maxCharsPerLine": 40,
      "copies":          1
    }
  },

  "fileEncoding":        "latin1",
  "fileAction":          "MOVE",
  "pollingIntervalMs":   1000,
  "fileStabilizeMs":     500,
  "retryCount":          3,
  "retryIntervalMs":     5000,

  "toastEnabled":        true,
  "toastOnSuccess":      true,
  "toastOnError":        true
}
